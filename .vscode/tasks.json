{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Finger Sequencer AU",
      "type": "shell",
      "command": "/Applications/CMake.app/Contents/bin/cmake",
      "args": ["--build", "build", "--target", "FingerSequencer_AU", "-j", "6"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
